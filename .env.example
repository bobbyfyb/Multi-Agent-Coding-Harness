# Choose one provider and fill in its credentials.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=replace-me
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI alternative:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1

LLM_CONTEXT_WINDOW=100000
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=240
LLM_MAX_RETRIES=4
LLM_MAX_RETRY_ELAPSED_SECONDS=300
LLM_ESCALATED_MAX_TOKENS=8192
LLM_MAX_CONTINUATIONS=2

BACKGROUND_MAX_CONCURRENT=4
BACKGROUND_MAX_RUNTIME_SECONDS=1800

# Optional integrations:
# SEARCH_API_KEY=replace-me
# CONTEXT7_API_KEY=replace-me
